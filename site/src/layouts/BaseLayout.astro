---
/** @fileoverview Base layout for Museum pages, to be extended by other layouts. */

import "@/assets/styles/styles.css";

import { AnnotationList } from "@/components/Annotations";
import CookieBanner from "@/components/CookieBanner.astro";
import WaiHeader from "@/components/WaiHeader.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href=`${import.meta.env.BASE_URL}favicon.svg` />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - The Museum of Broken Things</title>
  </head>
  <body class={import.meta.env.PUBLIC_FIXED ? "fixed" : undefined}>
    <a class="visually-hidden" href="#main">Skip to the main content</a>
    <WaiHeader />
    <slot />
    <CookieBanner />
    <AnnotationList client:only="preact" />
  </body>
</html>
